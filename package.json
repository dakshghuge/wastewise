{
  "name": "wastewise-ai",
  "version": "1.0.0",
  "private": true,
  "main": "src/server.js",
  "description": "WasteWise AI helps people identify, reuse, recycle, and safely dispose of waste.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "esbuild public/assets/js/app.js --bundle --format=esm --platform=browser --target=es2020 --outfile=public/assets/js/app.bundle.js",
    "start": "npm run build && node src/server.js",
    "dev": "npm run build && node --watch src/server.js",
    "deploy:hosting": "npm run build && firebase deploy --only hosting --project wastewise-836c3",
    "test": "npm run build && node --test"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "firebase": "^12.0.0",
    "helmet": "^8.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
